# Copy to .env.local and fill in. Never commit .env.local.

# Supabase dashboard → Project Settings → Data API → Project URL
SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase dashboard → Project Settings → API Keys → Secret key (sb_secret_...)
# Older projects: use the "service_role" key from the Legacy API Keys tab.
# Server-only. Do NOT prefix with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=

# Google Analytics 4 (service account with Viewer access on the GA4 property)
# GA4 → Admin → Property details → Property ID (numbers only)
GA4_PROPERTY_ID=
# Google Cloud → IAM → Service accounts → the account's email
GOOGLE_CLIENT_EMAIL=
# From the service account's JSON key. Keep it in quotes on one line with \n line breaks.
# Server-only. Do NOT prefix with NEXT_PUBLIC_.
GOOGLE_PRIVATE_KEY=
